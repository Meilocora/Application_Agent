# Copy this file to .env and fill in your values. .env is ignored by git - never commit real keys.

# --- Required ---------------------------------------------------------------
# Used by the OpenAI Agents SDK for all agents (profile, scout, matcher, letter writer/reviewer).
OPENAI_API_KEY=sk-...

# --- Optional ---------------------------------------------------------------
# Google Maps key with the "Routes API" enabled. Without it, commute times are skipped.
GOOGLE_MAPS_API_KEY=

# Models. Defaults shown - uncomment to change.
# APP_FAST_MODEL=gpt-5.4-mini      # profile extraction, job search, matching, letter review
# APP_WRITER_MODEL=gpt-5.5         # cover letters only - quality matters more than cost there

# Cover letter: how many revisions may follow the first review.
# APP_MAX_REVISIONS=2

# Job search: how many postings the scout shortlists, and how many are assessed in parallel.
# APP_MAX_SHORTLIST=8
# APP_MAX_PARALLEL_MATCHES=4

# Where your data lives (database, Excel, Word files, preferences). Default: ./data
# APP_DATA_DIR=data
# Your CV, references and project notes (PDF, Word, Markdown or text). Default: <APP_DATA_DIR>/profile
# APP_PROFILE_DIR=data/profile
